{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KerbaLoc",
  "version": "0.1.0",
  "identifier": "dev.kerbaloc.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "KerbaLoc 스튜디오",
        "width": 1000,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxMTEwRDEwMjkzOUQ0MjgKUldRbzFEa3BFQTBSWVlXMmszUDkrdGVVdGNLQjIvNjN6ZWhrQ2RUUlVzVTY5Q2JPZ2lpRlVYZkwK",
      "endpoints": [
        "https://github.com/csh1668/kerbaloc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
